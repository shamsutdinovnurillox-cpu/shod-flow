# ============================================================================
# Shod Flow — muhit o'zgaruvchilari namunasi.
# `.env` fayliga nusxalab, qiymatlarni to'ldiring.
# ============================================================================

# ---- Ma'lumotlar bazasi (PostgreSQL) ----
# Lokal: `docker compose up -d` (docker-compose.yml, host porti 5433).
# Prodda Neon URL'i bilan almashtiriladi (sslmode=require bilan).
DATABASE_URL="postgresql://shodflow:shodflow@localhost:5433/shodflow"

# ---- Auth (NextAuth v5) ----
# Yangi sir yaratish: npx auth secret  (yoki openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Fayl saqlash (ixtiyoriy) ----
# S3_BUCKET bo'sh bo'lsa fayllar lokal diskda (.uploads/) saqlanadi.
S3_BUCKET=
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Cron (production'da majburiy) ----
# /api/cron/notifications endpointini himoya qiladi (Vercel cron avtomatik yuboradi).
CRON_SECRET=
